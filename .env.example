# App runtime
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3000
# Comma-separated frontend origins allowed to call the API in production.
CORS_ORIGIN=http://localhost:3000

# AI
GEMINI_API_KEY=your_gemini_api_key

# Database (optional for local dev; required when using PostgreSQL in production)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Frontend API base URL used by Vercel / production deployment
# Example: https://smart-survey-hub.onrender.com/api
VITE_API_URL=http://localhost:3001/api

# Public app URL used for survey share links and QR codes
# Example: https://smart-survey-hub.vercel.app or your custom domain
VITE_PUBLIC_APP_URL=http://localhost:5173

# Firebase (client-side, safe to expose)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_URL=https://your_project.firebasedatabase.app

# Firebase Admin (server-side, keep secret)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
