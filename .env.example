# App runtime
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3000

# AI
GEMINI_API_KEY=your_gemini_api_key

# Database (optional for local dev; required when using PostgreSQL in production)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Frontend API base URL used by Vercel / production deployment
# Example: https://smart-survey-hub.onrender.com/api
VITE_API_URL=http://localhost:3001/api
